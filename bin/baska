#!/usr/bin/env sh
set -eu

VERSION="0.2.0"
REPO_OWNER="${BASKA_REPO_OWNER:-baska-pro}"
REPO_NAME="${BASKA_REPO_NAME:-baska-hub}"
BRANCH="${BASKA_REPO_BRANCH:-main}"
RAW_BASE="https://raw.githubusercontent.com/${REPO_OWNER}/${REPO_NAME}/${BRANCH}"
BASKA_HOME="${BASKA_HOME:-$HOME/.baska}"
CACHE_DIR="$BASKA_HOME/cache"
PACKAGES_DIR="$BASKA_HOME/packages"
REGISTRY="$CACHE_DIR/packages.tsv"

mkdir -p "$CACHE_DIR" "$PACKAGES_DIR"

say() { printf '%s\n' "$*"; }
err() { printf 'ERROR: %s\n' "$*" >&2; }
fail() { err "$*"; exit 1; }

fetch() {
  url="$1"; out="$2"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --retry 3 --connect-timeout 15 "$url" -o "$out"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$out" "$url"
  else
    fail "curl atau wget diperlukan."
  fi
}

platform() {
  if [ -n "${TERMUX_VERSION:-}" ] || { [ -n "${PREFIX:-}" ] && printf '%s' "$PREFIX" | grep -q 'com.termux'; }; then
    printf 'termux\n'
  elif [ -f /etc/os-release ]; then
    . /etc/os-release
    printf '%s\n' "${ID:-linux}"
  else
    printf 'linux\n'
  fi
}

arch() {
  uname -m 2>/dev/null || printf 'unknown\n'
}

refresh() {
  tmp="$REGISTRY.tmp"
  fetch "$RAW_BASE/registry/packages.tsv" "$tmp"
  mv "$tmp" "$REGISTRY"
  say "Registry diperbarui."
}

ensure_registry() {
  [ -s "$REGISTRY" ] || refresh >/dev/null
}

record() {
  ensure_registry
  q="$1"
  awk -F '\t' -v q="$q" '
    NR > 1 {
      if ($1 == q || $2 == q) { print; exit }
      n = split($3, aliases, ",")
      for (i = 1; i <= n; i++) {
        if (aliases[i] == q) { print; exit }
      }
    }
  ' "$REGISTRY"
}

field() {
  line="$1"; num="$2"
  printf '%s\n' "$line" | awk -F '\t' -v n="$num" '{print $n}'
}

compatible() {
  targets="$1"; current="$(platform)"
  [ "$targets" = "all" ] && return 0
  printf '%s' "$targets" | tr ',' '\n' | grep -qx "$current" && return 0
  [ "$current" != "termux" ] && printf '%s' "$targets" | tr ',' '\n' | grep -qx 'linux' && return 0
  return 1
}

verify_sha256() {
  file="$1"; expected="$2"
  [ -z "$expected" ] || [ "$expected" = "-" ] && return 0
  if command -v sha256sum >/dev/null 2>&1; then
    actual="$(sha256sum "$file" | awk '{print $1}')"
  elif command -v shasum >/dev/null 2>&1; then
    actual="$(shasum -a 256 "$file" | awk '{print $1}')"
  else
    fail "Checksum tersedia di registry tetapi sha256sum/shasum tidak ditemukan."
  fi
  [ "$actual" = "$expected" ] || { rm -f "$file"; fail "SHA-256 tidak cocok. File dibatalkan."; }
}

list_packages() {
  ensure_registry
  printf '%-7s %-20s %-18s %-10s %-12s %s\n' "ID" "SLUG" "NAMA" "KATEGORI" "VERSI" "PLATFORM"
  printf '%-7s %-20s %-18s %-10s %-12s %s\n' "-------" "--------------------" "------------------" "----------" "------------" "--------"
  awk -F '\t' 'NR>1 {printf "%-7s %-20s %-18s %-10s %-12s %s\n",$1,$2,$4,$5,$7,$8}' "$REGISTRY"
}

search_packages() {
  ensure_registry
  q="${1:-}"
  [ -n "$q" ] || fail "Gunakan: baska search <kata>"
  awk -F '\t' -v q="$q" '
    NR > 1 {
      text = tolower($0)
      needle = tolower(q)
      if (index(text, needle))
        printf "%-7s %-20s %-18s %s\n",$1,$2,$4,$12
    }
  ' "$REGISTRY"
}

info_package() {
  q="${1:-}"; [ -n "$q" ] || fail "Gunakan: baska info <id|nama>"
  line="$(record "$q")"; [ -n "$line" ] || fail "Paket '$q' tidak ditemukan."
  say "ID          : $(field "$line" 1)"
  say "Slug        : $(field "$line" 2)"
  say "Alias       : $(field "$line" 3)"
  say "Nama        : $(field "$line" 4)"
  say "Kategori    : $(field "$line" 5)"
  say "Tipe        : $(field "$line" 6)"
  say "Versi       : $(field "$line" 7)"
  say "Platform    : $(field "$line" 8)"
  say "Sumber      : $(field "$line" 9)"
  say "Aksi        : $(field "$line" 10)"
  say "SHA-256     : $(field "$line" 11)"
  say "Deskripsi   : $(field "$line" 12)"
}

ensure_git() {
  command -v git >/dev/null 2>&1 || fail "git diperlukan untuk paket berbasis repository."
}

download_package() {
  q="${1:-}"; requested="${2:-}"
  [ -n "$q" ] || fail "Gunakan: baska get <id|nama> [tujuan]"
  line="$(record "$q")"; [ -n "$line" ] || fail "Paket '$q' tidak ditemukan."

  pid="$(field "$line" 1)"
  slug="$(field "$line" 2)"
  type="$(field "$line" 6)"
  source="$(field "$line" 9)"
  sha="$(field "$line" 11)"

  if [ "$type" = "repo" ]; then
    ensure_git
    if [ -n "$requested" ]; then out="$requested"; else out="$PWD/$slug"; fi
    [ ! -e "$out" ] || fail "Tujuan sudah ada: $out"
    say "Meng-clone $slug ($pid)..."
    git clone --depth 1 "$source" "$out"
    say "$out"
    return 0
  fi

  name="$(basename "$source")"
  if [ -n "$requested" ]; then
    if [ -d "$requested" ]; then out="$requested/$name"; else out="$requested"; fi
  elif [ "$type" = "apk" ] && [ -d "$HOME/storage/downloads" ]; then
    out="$HOME/storage/downloads/$name"
  else
    out="$PWD/$name"
  fi

  mkdir -p "$(dirname "$out")"
  say "Mengunduh $slug ($pid)..."
  fetch "$source" "$out"
  verify_sha256 "$out" "$sha"
  say "$out"
}

install_package() {
  q="${1:-}"; [ -n "$q" ] || fail "Gunakan: baska install <id|nama>"
  line="$(record "$q")"; [ -n "$line" ] || fail "Paket '$q' tidak ditemukan."

  pid="$(field "$line" 1)"
  slug="$(field "$line" 2)"
  targets="$(field "$line" 8)"
  source="$(field "$line" 9)"
  action="$(field "$line" 10)"
  sha="$(field "$line" 11)"

  compatible "$targets" || fail "Paket '$slug' tidak kompatibel dengan platform $(platform)."

  case "$action" in
    recipe:*)
      recipe="${action#recipe:}"
      tmp="$CACHE_DIR/recipe-${pid}.sh"
      say "Mengambil recipe instalasi $slug..."
      fetch "$RAW_BASE/$recipe" "$tmp"
      chmod 700 "$tmp"
      BASKA_PACKAGE_ID="$pid" \
      BASKA_PACKAGE_SLUG="$slug" \
      BASKA_PACKAGE_SOURCE="$source" \
      BASKA_PACKAGE_HOME="$PACKAGES_DIR/$slug" \
      sh "$tmp"
      ;;
    open)
      file="$(download_package "$q" | tail -n 1)"
      if command -v termux-open >/dev/null 2>&1; then
        termux-open "$file"
        say "Installer Android dibuka."
      elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$file" >/dev/null 2>&1 || true
        say "File telah diunduh: $file"
      else
        say "File telah diunduh: $file"
      fi
      ;;
    executable)
      dir="$PACKAGES_DIR/$slug"; mkdir -p "$dir"
      file="$dir/$(basename "$source")"
      fetch "$source" "$file"
      verify_sha256 "$file" "$sha"
      chmod 755 "$file"
      say "Terpasang: $file"
      ;;
    git)
      ensure_git
      dir="$PACKAGES_DIR/$slug"
      if [ -d "$dir/.git" ]; then
        git -C "$dir" pull --ff-only
      else
        [ ! -e "$dir" ] || fail "Target sudah ada dan bukan repository: $dir"
        git clone --depth 1 "$source" "$dir"
      fi
      say "Repository tersedia di: $dir"
      ;;
    download|file)
      download_package "$q" >/dev/null
      ;;
    *) fail "Aksi instalasi '$action' belum didukung CLI v$VERSION." ;;
  esac
}

update_command() {
  if [ $# -gt 0 ]; then
    install_package "$1"
  else
    refresh
  fi
}

self_update() {
  target="$0"
  [ -w "$target" ] || fail "Tidak dapat menulis $target. Jalankan bootstrap installer kembali bila diperlukan."
  tmp="$CACHE_DIR/baska.new"
  fetch "$RAW_BASE/bin/baska" "$tmp"
  chmod 755 "$tmp"
  mv "$tmp" "$target"
  say "BASKA CLI diperbarui."
}

doctor() {
  say "BASKA CLI    : v$VERSION"
  say "Platform     : $(platform)"
  say "Arsitektur   : $(arch)"
  say "Home         : $BASKA_HOME"
  say "Repository   : $REPO_OWNER/$REPO_NAME@$BRANCH"
  if command -v curl >/dev/null 2>&1; then say "Downloader   : curl";
  elif command -v wget >/dev/null 2>&1; then say "Downloader   : wget";
  else say "Downloader   : TIDAK ADA"; fi
  if command -v git >/dev/null 2>&1; then say "Git          : tersedia"; else say "Git          : tidak tersedia"; fi
  if command -v python3 >/dev/null 2>&1; then say "Python       : $(python3 --version 2>&1)"; fi
  if command -v termux-open >/dev/null 2>&1; then say "Android open : tersedia"; fi
}

usage() {
  cat <<'EOF'
BASKA Hub CLI

Penggunaan:
  baska list
  baska search <kata>
  baska info <id|nama>
  baska get <id|nama> [tujuan]
  baska install <id|nama>
  baska update [id|nama]
  baska refresh
  baska self-update
  baska doctor
  baska version
  baska help

Contoh:
  baska install server-control
  baska install 00001
  baska install kuisingo
  baska install 00002
EOF
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift || true
case "$cmd" in
  list) list_packages "$@" ;;
  search) search_packages "$@" ;;
  info) info_package "$@" ;;
  get|download) download_package "$@" ;;
  install) install_package "$@" ;;
  update) update_command "$@" ;;
  refresh) refresh ;;
  self-update) self_update ;;
  doctor) doctor ;;
  version|--version|-v) say "baska $VERSION" ;;
  help|--help|-h) usage ;;
  *) err "Command tidak dikenal: $cmd"; usage; exit 2 ;;
esac
