  function isDuplicateUpdate_(updateId){
    if(updateId==null) return false;
    const key='lftg_upd_'+String(updateId), cache=CacheService.getScriptCache();
    const lock=LockService.getScriptLock();
    try{
      lock.tryLock(1500);
      if(cache.get(key)) return true;
      cache.put(key,'1',21600);
      return false;
    }catch(_){
      try{if(cache.get(key))return true;cache.put(key,'1',21600);}catch(__){}
      return false;
    }finally{try{lock.releaseLock();}catch(_){}}
  }

  function handleUpdate_(e,update){
    const key = e && e.parameter ? String(e.parameter.key || '') : '';
    if (!webhookKey_() || key !== webhookKey_()) return json_({ok:false,error:'invalid_webhook_key'});
    update = update || {};
    if (isDuplicateUpdate_(update.update_id)) return json_({ok:true,duplicate:true});
    try {
      if(update.callback_query){const q=update.callback_query,chat=q.message&&q.message.chat&&q.message.chat.id;if(!chat)return json_({ok:true,ignored:true});handleCallback_(chat,q.id,String(q.data||''),q.message&&q.message.message_id);return json_({ok:true});}
      const m=update.message||update.edited_message;if(!m||!m.chat)return json_({ok:true,ignored:true});const chatId=m.chat.id;if(!isAllowed_(chatId))return json_({ok:true,unauthorized:true});const text=String(m.text||'').trim();if(!text)return json_({ok:true,ignored:true});if(text.charAt(0)==='/')handleCommand_(chatId,m.message_id,text);else handleText_(chatId,m.message_id,text);return json_({ok:true});
    } catch(err){console.error('[LAVI TG webhook] '+(err.stack||err));return json_({ok:false,error:String(err.message||err)});}
  }
  function json_(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);}
  function relaySecret_(){
    const bridge=String(getLaviBridgeSecret_()||'').trim();
    if(!bridge) throw new Error('LAVI_BRIDGE_SECRET belum dikonfigurasi.');
    const bytes=Utilities.computeHmacSha256Signature('lavi-finance-telegram-relay-v1',bridge,Utilities.Charset.UTF_8);
    return Utilities.base64EncodeWebSafe(bytes).replace(/=+$/g,'');
  }
  function relaySecretHash_(){
    const bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,relaySecret_(),Utilities.Charset.UTF_8);
    return Utilities.base64EncodeWebSafe(bytes).replace(/=+$/g,'');
  }
  function constantEq_(a,b){
    a=String(a||'');b=String(b||'');let diff=a.length^b.length;const n=Math.max(a.length,b.length);
    for(let i=0;i<n;i++) diff|=(a.charCodeAt(i%Math.max(1,a.length))||0)^(b.charCodeAt(i%Math.max(1,b.length))||0);
    return diff===0;
  }
  function relayGet_(e){
    const p=e&&e.parameter?e.parameter:{};
    const enc=String(p.u||''),sig=String(p.sig||'');
    if(!enc||enc.length>12000||!sig) return json_({ok:false,error:'invalid_relay_payload'});
    try{
      const bytes=Utilities.base64DecodeWebSafe(enc);
      const text=Utilities.newBlob(bytes).getDataAsString('UTF-8');
      const expected=Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(text,relaySecret_(),Utilities.Charset.UTF_8)).replace(/=+$/g,'');
      if(!constantEq_(sig,expected)) return json_({ok:false,error:'invalid_relay_signature'});
      const update=JSON.parse(text);
      return handleUpdate_({parameter:{key:webhookKey_()}},update);
    }catch(err){
      console.error('[LAVI TG relay] '+(err.stack||err));
      return json_({ok:false,error:'relay_decode_failed'});
    }
  }
  function setup_(){
    const token=token_(),ids=allowedIds_(); if(!token)throw new Error('LAVI_FINANCE_TELEGRAM_TOKEN belum ada di Script Properties.');if(!ids.length)throw new Error('LAVI_FINANCE_TELEGRAM_ALLOWED_CHAT_IDS belum ada.');
    const me=tg_('getMe',{},1),key=getOrCreateWebhookKey_();
    const url='https://lavi-finance-new.latieftjm.workers.dev/telegram-webhook';
    tg_('setMyCommands',{commands:[{command:'start',description:'Buka Menu Utama'},{command:'menu',description:'Menu Interaktif Keuangan'},{command:'total',description:'Cek Saldo Cepat'}]},1);
    const hook=tg_('setWebhook',{url:url,secret_token:relaySecret_(),drop_pending_updates:true,allowed_updates:['message','callback_query']},1);
    return {ok:true,version:VERSION,botConfigured:!!me,username:me&&me.username?('@'+me.username):'',allowedChats:ids.length,webhookConfigured:!!hook,webhookBase:url};
  }
  function status_(){let me=null,wh=null,error='';try{me=tg_('getMe',{},0);wh=tg_('getWebhookInfo',{},0);}catch(e){error=String(e.message||e);}return {ok:!!me&&!!wh,version:VERSION,tokenConfigured:!!token_(),allowedChats:allowedIds_().length,webhookKeyConfigured:!!webhookKey_(),bot:me?{id:me.id,username:me.username||''}:null,webhook:wh?{url:wh.url||'',pendingUpdateCount:wh.pending_update_count||0,lastErrorDate:wh.last_error_date||0,lastErrorMessage:wh.last_error_message||''}:null,error:error};}
  function selfTest_(){
    const sample=[
      {id:'TX-TEST001',tanggal:'12/09/2026',jenis:'Pengeluaran',kategoriPerson:'Abi',kategoriPilihan:'Makanan & Minuman',jenisSaldo:'Cash',sumberDana:'Cash',tujuanDana:'',nominal:25000,keterangan:'Test'},
