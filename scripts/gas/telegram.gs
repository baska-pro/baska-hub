    else if(type==='date_prevmonth'){matched=all.filter(t=>String(t.tanggal).endsWith(prevMY));title='BULAN LALU ('+prevMY+')';}
    else if(type==='custom_date'){matched=all.filter(t=>String(t.tanggal).trim()===String(val).trim());title='TANGGAL '+val;}
    else if(type==='date_range'){const ps=String(val||'').toLowerCase().replace(/s\/d|sampai|to/g,'-').split('-').map(x=>x.trim()).filter(Boolean);let d1=ps[0]&&parseDate_(ps[0]),d2=ps[1]&&parseDate_(ps[1]);if(d1&&d2){if(d1>d2){const x=d1;d1=d2;d2=x;}matched=all.filter(t=>{const d=parseDate_(t.tanggal);return d&&d>=d1&&d<=d2;});title='RENTANG ('+fmtDate_(d1)+' s/d '+fmtDate_(d2)+')';}else title='RENTANG TANGGAL TIDAK VALID';}
    else if(type==='person'){matched=all.filter(t=>String(t.kategoriPerson).toLowerCase()===String(val).toLowerCase());title='PERSON: '+String(val).toUpperCase();}
