  function categoriesFor_(jenis) {
    if (jenis === 'Pemindahan Saldo') return ['Pemindahan Saldo'];
    const m = masterData_();
    if (jenis === 'Pemasukan') return m.pemasukan || FALLBACK_CATEGORIES.pemasukan;
    if (jenis === 'Investasi dan Tabungan') return m.jenisTabungan || FALLBACK_CATEGORIES.jenisTabungan;
    return m.pengeluaran || FALLBACK_CATEGORIES.pengeluaran;
  }
  function wallets_() { const m=masterData_(); return (m.jenisSaldo && m.jenisSaldo.length ? m.jenisSaldo : FALLBACK_CATEGORIES.jenisSaldo).slice(); }
  function categoryMenu_(jenis,page,edit) {
    const all=categoriesFor_(jenis), pages=Math.max(1,Math.ceil(all.length/ITEMS_PER_PAGE)); page=Math.max(1,Math.min(Number(page)||1,pages));
    const list=all.slice((page-1)*ITEMS_PER_PAGE,page*ITEMS_PER_PAGE), rows=[]; let row=[];
    list.forEach(c=>{ row.push(btn_(c,(edit?'save_edit_field:kategoriPilihan:':'set_cat:')+c)); if(row.length===2){rows.push(row);row=[];} }); if(row.length)rows.push(row);
    if(pages>1) rows.push([btn_('⬅️ Prev',(edit?'edit_cat_page:':'cat_page:')+(page>1?page-1:pages)),btn_('📄 '+page+'/'+pages,'noop'),btn_('Next ➡️',(edit?'edit_cat_page:':'cat_page:')+(page<pages?page+1:1))]);
    rows.push([btn_('✏️ Ketik '+(edit?'Custom':'Kategori Custom'),edit?'prompt_edit_custom_cat':'prompt_custom_cat')]);
    rows.push([btn_('◀️ '+(edit?'Batal Edit':'Kembali'),edit?'edit_back_to_summary':'set_type_back'),btn_('❌ Batal','btn_menu')]); return rows;
  }
  function walletMenu_(transferKind) {
    const rows=[]; let row=[];
    wallets_().forEach(s=>{ if(transferKind && s==='Penyesuaian')return; const prefix=transferKind==='asal'?'set_saldo_asal:':transferKind==='tujuan'?'set_saldo_tujuan:':'set_saldo:'; row.push(btn_((s==='Cash'?'💵 ':s.indexOf('Kartu')>=0?'💳 ':'🏦 ')+s,prefix+s)); if(row.length===2){rows.push(row);row=[];} }); if(row.length)rows.push(row);
    if(transferKind) rows.push([btn_('◀️ Kembali',transferKind==='asal'?'set_type_back':'set_saldo_asal_back'),btn_('❌ Batal','btn_menu')]);
    else rows.push([btn_('◀️ Kembali','set_cat_back'),btn_('❌ Batal','btn_menu')]); return rows;
  }
