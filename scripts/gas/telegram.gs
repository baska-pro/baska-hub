    const all=transactions_(chatId,TX_FETCH_LIMIT); const now=now_(),today=fmtDate_(now),yd=fmtDate_(new Date(now.getTime()-86400000)); const curMY=Utilities.formatDate(now,TZ,'MM/yyyy'); const first=new Date(now.getFullYear(),now.getMonth(),1,12),prev=new Date(first.getTime()-86400000),prevMY=Utilities.formatDate(prev,TZ,'MM/yyyy'); const wd=(now.getDay()+6)%7,weekStart=new Date(now.getTime()-wd*86400000); weekStart.setHours(0,0,0,0);
