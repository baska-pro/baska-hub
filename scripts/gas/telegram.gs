    else if(type==='wallet'){matched=all.filter(t=>[t.jenisSaldo,t.sumberDana].some(x=>String(x).toLowerCase()===String(val).toLowerCase()));title='DOMPET: '+String(val).toUpperCase();}
    else if(type==='keyword'){const q=String(val).toLowerCase();matched=all.filter(t=>[t.kategoriPilihan,t.kategoriPerson,t.keterangan,t.jenisSaldo,t.sumberDana,t.tujuanDana,t.jenis,String(t.nominal)].some(x=>String(x).toLowerCase().indexOf(q)>=0));title='KATA KUNCI: «'+val+'»';}
    else{matched=all.slice(0,50);title='50 TRANSAKSI TERBARU';}
    const pages=Math.max(1,Math.ceil(matched.length/TX_PER_PAGE));page=Math.max(1,Math.min(Number(page)||1,pages));const start=(page-1)*TX_PER_PAGE,items=matched.slice(start,start+TX_PER_PAGE);const masuk=matched.filter(t=>t.jenis==='Pemasukan').reduce((a,t)=>a+t.nominal,0),keluar=matched.filter(t=>t.jenis==='Pengeluaran').reduce((a,t)=>a+t.nominal,0),net=masuk-keluar;
    const lines=['<b>🔍 FILTER — '+esc_(title)+'</b>','━━━━━━━━━━━━━━━━━━━━','📊 '+matched.length+' transaksi  |  Hal '+page+'/'+pages,'🟢 Masuk  : '+rupiah_(masuk),'🔴 Keluar : '+rupiah_(keluar),(net>=0?'🟢':'🔴')+' Net     : <b>'+rupiah_(net)+'</b>','━━━━━━━━━━━━━━━━━━━━\n']; const rows=[];
    items.forEach((t,i)=>{lines.push(txCard_(t,start+i+1),'');const ic=t.jenis==='Pengeluaran'?'🔴':t.jenis==='Pemasukan'?'🟢':'🔄';rows.push([btn_((start+i+1)+'. '+ic+' '+rupiah_(t.nominal)+' – '+String(t.kategoriPilihan||t.jenis).slice(0,22),'tx_view:'+t.id)]);}); if(!items.length)lines.push('ℹ️ <i>Tidak ada transaksi yang sesuai filter.</i>'); if(pages>1)rows.push([btn_('⬅️ Prev','filter_page:'+(page>1?page-1:pages)),btn_('📄 '+page+'/'+pages,'noop'),btn_('Next ➡️','filter_page:'+(page<pages?page+1:1))]); rows.push([btn_('🔍 Filter Lain','btn_filter_menu'),btn_('◀️ Menu Utama','btn_menu')]); sendOrEdit_(chatId,lines.join('\n'),rows);
  }

  function showRecent_(chatId){progress_(chatId,'📜 MEMUAT TRANSAKSI TERAKHIR',['Mengambil 10 transaksi terbaru...']);const txs=transactions_(chatId,10),lines=['<b>📋 10 TRANSAKSI TERAKHIR</b>','━━━━━━━━━━━━━━━━━━━━\n'],rows=[];if(txs.length){txs.forEach((t,i)=>{lines.push(txCard_(t,i+1),'');const ic=t.jenis==='Pengeluaran'?'🔴':t.jenis==='Pemasukan'?'🟢':'🔄';rows.push([btn_((i+1)+'. '+ic+' '+rupiah_(t.nominal)+' – '+String(t.kategoriPilihan||t.jenis).slice(0,22),'tx_view:'+t.id)]);});rows.push([btn_('➕ Catat Baru','wizard_start'),btn_('🔍 Filter & Cari','btn_filter_menu')]);rows.push([btn_('◀️ Menu Utama','btn_menu')]);}else{lines.push('ℹ️ <b>Belum ada transaksi tercatat.</b>');rows.push([btn_('➕ Catat Transaksi Baru','wizard_start')],[btn_('◀️ Menu Utama','btn_menu')]);}sendOrEdit_(chatId,lines.join('\n'),rows);}

  function showBalance_(chatId,personKey){
