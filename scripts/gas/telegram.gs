  const UNDO_WINDOW_MS = 60 * 1000;
  function numProp_(name,fallback){
    const n=Number(props_().getProperty(name));
    return Number.isFinite(n) && n >= 0 ? n : Number(fallback || 0);
  }
  function expenseRisk_(s){
    const out={large:false,low:false,threshold:numProp_('LAVI_FINANCE_TELEGRAM_LARGE_EXPENSE_THRESHOLD',500000),lowThreshold:numProp_('LAVI_FINANCE_TELEGRAM_LOW_BALANCE_THRESHOLD',100000),balance:null,remaining:null,messages:[]};
    if(!s || String(s.jenis)!=='Pengeluaran') return out;
    const nominal=Number(s.nominal)||0;
    if(nominal>=out.threshold){out.large=true;out.messages.push('Nominal '+rupiah_(nominal)+' melewati batas peringatan '+rupiah_(out.threshold)+'.');}
    const wallet=String(s.saldo||'').trim();
    if(wallet && ['Kartu Kredit','Penyesuaian','P & L'].indexOf(wallet)<0){
      try{
        const b=calculateBalance(), person=b&&b.byPerson&&b.byPerson[s.person], by=person&&person.bySaldo||{};
        if(Object.prototype.hasOwnProperty.call(by,wallet)){
          out.balance=Number(by[wallet])||0;out.remaining=out.balance-nominal;
          if(out.remaining<out.lowThreshold){out.low=true;out.messages.push('Perkiraan saldo '+wallet+' setelah transaksi: '+rupiah_(out.remaining)+' (batas rendah '+rupiah_(out.lowThreshold)+').');}
        }
      }catch(_){}
    }
    return out;
  }
  function sensitiveSaveText_(s,risk){
    const lines=['<b>🛡️ KONFIRMASI AKSI SENSITIF</b>','━━━━━━━━━━━━━━━━━━━━'];
    if(s && s.jenis==='Pemindahan Saldo') lines.push('🔄 Pemindahan saldo akan mengubah saldo asal dan tujuan.');
    (risk&&risk.messages||[]).forEach(m=>lines.push('🚨 '+esc_(m)));
    lines.push('',confirmationText_(s),'','<b>Lanjutkan penyimpanan?</b>');
    return lines.join('\n');
  }
  function undoInfo_(s){
    const at=Number(s&&s.last_transaction_at||0),id=String(s&&s.last_transaction_id||'');
    const age=at?Date.now()-at:Number.POSITIVE_INFINITY;
    return {id:id,at:at,age:age,valid:!!id&&age>=0&&age<=UNDO_WINDOW_MS,remaining:Math.max(0,UNDO_WINDOW_MS-age)};
  }
  function performUndo_(chatId){
    const s=getSession_(chatId),u=undoInfo_(s);
    if(!u.valid){
      delete s.last_transaction_id;delete s.last_transaction_at;saveSession_(chatId,s);
      sendOrEdit_(chatId,'⏱️ <b>Waktu pembatalan sudah berakhir.</b>\nTransaksi hanya dapat dibatalkan maksimal 1 menit setelah dibuat.',[[btn_('📜 10 Transaksi Terakhir','btn_recent_10')],[btn_('◀️ Menu Utama','btn_menu')]]);return;
    }
    let res;try{res=deleteTransaction(u.id);}catch(e){res={success:false,message:String(e)}}
    clearTxCache_(chatId);
    if(res&&res.success){delete s.last_transaction_id;delete s.last_transaction_at;delete s.last_payload;saveSession_(chatId,s);sendOrEdit_(chatId,'<b>↩️ TRANSAKSI BERHASIL DIBATALKAN</b>\n━━━━━━━━━━━━━━━━━━━━\n🆔 <code>'+esc_(u.id)+'</code>\nData transaksi dihapus dan saldo akan mengikuti data terbaru.',[[btn_('➕ Catat Baru','wizard_start'),btn_('📜 Riwayat','btn_recent_10')],[btn_('◀️ Menu Utama','btn_menu')]]);}else sendOrEdit_(chatId,'❌ <b>Gagal membatalkan transaksi.</b>\n'+esc_(res&&res.message||'Transaksi tidak dapat dihapus.'),[[btn_('◀️ Menu Utama','btn_menu')]]);
  }
