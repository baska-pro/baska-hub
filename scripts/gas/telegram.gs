    other.forEach(p=>{row.push(btn_('👤 '+p,'set_person_tujuan:'+p));if(row.length===2){rows.push(row);row=[];}});if(row.length)rows.push(row);
    rows.push([btn_('◀️ Kembali','set_saldo_tujuan_back'),btn_('❌ Batal','btn_menu')]); return rows;
