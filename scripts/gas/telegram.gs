    if(data.indexOf('export_do:')===0){sendExport_(chatId,data.substring(10));return;}
    if(data==='btn_filter_menu'){sendOrEdit_(chatId,'<b>🔍 FILTER & CARI TRANSAKSI</b>\n━━━━━━━━━━━━━━━━━━━━\n📅 <b>Tanggal</b> : Hari Ini, Kemarin, Minggu, Bulan\n👤 <b>Person</b> : Abi, Ummah, Dafiq, Laviska, Toko\n🏷️ <b>Jenis</b> : Pemasukan / Pengeluaran / Investasi\n💳 <b>Dompet</b> : Cash, Dana, Gopay, dll.\n🔤 <b>Kata Kunci</b>: Cari teks bebas',filterMenu_());return;}
