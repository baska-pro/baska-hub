/**
 * LAVI FINANCE PRO — TELEGRAM BOT FOR GAS BACKEND
 * Ported from lavi-finance.py (Python polling bot) to Google Apps Script webhook.
 *
 * Script Properties:
 *   LAVI_FINANCE_TELEGRAM_TOKEN
 *   LAVI_FINANCE_TELEGRAM_ALLOWED_CHAT_IDS   comma/semicolon/newline separated
 *   LAVI_FINANCE_TELEGRAM_WEBHOOK_KEY        auto-generated by setup if absent
 *
 * Public setup helpers:
 *   setupLaviFinanceTelegram()
 *   checkLaviFinanceTelegramStatus()
 *   resetLaviFinanceTelegramSession(chatId)
 *
 * Webhook is routed by Kode.js doPost() into handleLaviTelegramWebhook_().
 */

const LAVI_FINANCE_TELEGRAM = (() => {
  'use strict';

  const VERSION = '3.4.0-gas-relay';
  const TZ = 'Asia/Jakarta';
  const PROP = Object.freeze({
    TOKEN: 'LAVI_FINANCE_TELEGRAM_TOKEN',
    ALLOWED: 'LAVI_FINANCE_TELEGRAM_ALLOWED_CHAT_IDS',
    WEBHOOK_KEY: 'LAVI_FINANCE_TELEGRAM_WEBHOOK_KEY',
    PERSON_PREFIX: 'LAVI_FINANCE_TELEGRAM_PERSON_',
    SESSION_PREFIX: 'LAVI_FINANCE_TELEGRAM_SESSION_'
  });
  const CACHE_TTL = 60;
  const TX_FETCH_LIMIT = 200;
  const ITEMS_PER_PAGE = 20;
  const TX_PER_PAGE = 10;
  const SESSION_TTL_MS = 24 * 60 * 60 * 1000;

  const DEFAULT_PERSONS = ['Abi','Ummah','Dafiq','Laviska','Toko'];
  const FALLBACK_CATEGORIES = Object.freeze({
    pemasukan: [
      'Bagi Hasil','Bunga Tabungan','Capital Gain','Cashback','Dividen','Freelance / Proyek','Gaji / Upah','Hadiah','Hibah','Honor Tetap',
      'Jasa','Jual Aset Pribadi','Komisi / Affiliate','Laba Usaha','Penjualan Produk','Penyesuaian','Piutang Masuk','Pinjaman & Hutang','Refund','Reimburse','Royalti',
      'Saldo Top-Up','Sewa Properti','Tabungan / Investasi','THR / Bonus','Titipan','Tunjangan','Uang Bulanan','Uang Tambahan','Undian','Usaha Sampingan','Warisan'
    ],
    pengeluaran: [
      'Air Minum & Gas','BBM','Belanja Bulanan','Belanja Harian','Belanja Mingguan','Buku & Kursus','Dana Darurat','Dokter / Klinik','Hadiah & Kado','Hobi & Pribadi',
      'Hutang & Cicilan','Internet & TV Kabel','Iuran Kas','Jasa Lainnya','Kebersihan','Kebutuhan Anak','Keluarga & Orang Tua','Langganan Aplikasi','Listrik & Air',
      'Makanan & Minuman','Nongkrong / Hiburan','Obat-obatan','Ojek Online','Ongkos Kirim','Pajak & Admin Bank','Pakaian & Aksesoris','Parkir & Tol',
      'Pemberian Pinjaman','Penyesuaian','Piutang Keluar','Pulsa & Data','Rumah Tangga','SPP / Pendidikan','Sembako','Servis Kendaraan','Sewa / Cicilan Rumah',
      'Skincare & Grooming','Sumbangan & Donasi','Tabungan / Investasi','Transport Umum','Traveling','Zakat / Sedekah'
    ],
    jenisSaldo: ['Cash','Rekening','SeaBank','Shopeepay','Bank Jago','Dana','Gopay','E-Money','Kartu Kredit','Penyesuaian'],
    jenisTabungan: ['Bibit (Reksadana)','Emas (Investasi)','Stockbit (Saham)','Celengan']
  });
  const HARI = ['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
  const BULAN = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];

  function props_() { return PropertiesService.getScriptProperties(); }
  function token_() { return String(props_().getProperty(PROP.TOKEN) || '').trim(); }
  function allowedIds_() {
    const raw = String(props_().getProperty(PROP.ALLOWED) || '').trim();
    if (!raw) return [];
    try {
      const arr = JSON.parse(raw);
      if (Array.isArray(arr)) return Array.from(new Set(arr.map(String).map(v => v.trim()).filter(Boolean)));
    } catch (_) {}
    return Array.from(new Set(raw.split(/[\s,;]+/).map(v => v.trim()).filter(Boolean)));
  }
  function isAllowed_(chatId) {
    const ids = allowedIds_();
    return ids.length > 0 && ids.indexOf(String(chatId)) !== -1;
  }
  function webhookKey_() { return String(props_().getProperty(PROP.WEBHOOK_KEY) || '').trim(); }
  function getOrCreateWebhookKey_() {
    let key = webhookKey_();
    if (!key) {
      key = Utilities.getUuid().replace(/-/g,'') + Utilities.getUuid().replace(/-/g,'');
      props_().setProperty(PROP.WEBHOOK_KEY, key);
    }
    return key;
  }
  function sessionKey_(chatId) { return PROP.SESSION_PREFIX + String(chatId); }
  function personKey_(chatId) { return PROP.PERSON_PREFIX + String(chatId); }
  function sessionCacheKey_(chatId) { return 'lftg_sess_' + String(chatId); }
  function getSession_(chatId) {
    const cache = CacheService.getScriptCache();
    let raw = null;
    try { raw = cache.get(sessionCacheKey_(chatId)); } catch (_) {}
    if (!raw) raw = props_().getProperty(sessionKey_(chatId));
    if (!raw) return { step:'MENU', _updatedAt:Date.now() };
    try {
      const s = JSON.parse(raw) || {};
      if (s._updatedAt && Date.now() - Number(s._updatedAt) > SESSION_TTL_MS) return { step:'MENU', _updatedAt:Date.now() };
      try { cache.put(sessionCacheKey_(chatId), JSON.stringify(s), 21600); } catch (_) {}
      return s;
    } catch (_) { return { step:'MENU', _updatedAt:Date.now() }; }
  }
  function saveSession_(chatId, session) {
    session = session || {};
    session._updatedAt = Date.now();
    let json = JSON.stringify(session);
    if (json.length > 8500) {
      const compact = {
        step: session.step || 'MENU', last_msg_id: session.last_msg_id || null, last_payload: session.last_payload || null,
        last_transaction_id: session.last_transaction_id || null, last_transaction_at: session.last_transaction_at || null,
        filter_state: session.filter_state || null, export_spec: session.export_spec || null, tanggal:session.tanggal, person:session.person, jenis:session.jenis,
        kategori:session.kategori, saldo:session.saldo, saldo_asal:session.saldo_asal, saldo_tujuan:session.saldo_tujuan,
        person_tujuan:session.person_tujuan, nominal:session.nominal, keterangan:session.keterangan,
        editing_tx:session.editing_tx || null, deleting_tx:session.deleting_tx || null, keypad_val:session.keypad_val || '', _updatedAt:Date.now()
      };
      json = JSON.stringify(compact);
    }
    try { CacheService.getScriptCache().put(sessionCacheKey_(chatId), json, 21600); } catch (_) {}
    // Persist compact session so a cache eviction never breaks an in-progress wizard.
    props_().setProperty(sessionKey_(chatId), json);
  }
  function resetSession_(chatId, preserveMsg) {
    const old = getSession_(chatId);
    const next = { step:'MENU', _updatedAt:Date.now() };
    if (preserveMsg && old.last_msg_id) next.last_msg_id = old.last_msg_id;
    if (old.last_payload) next.last_payload = old.last_payload;
    if (old.last_transaction_id) next.last_transaction_id = old.last_transaction_id;
    if (old.last_transaction_at) next.last_transaction_at = old.last_transaction_at;
    saveSession_(chatId, next);
    return next;
  }
  function getMappedPerson_(chatId) { return String(props_().getProperty(personKey_(chatId)) || '').trim(); }
  function setMappedPerson_(chatId, person) {
    if (person) props_().setProperty(personKey_(chatId), String(person));
    else props_().deleteProperty(personKey_(chatId));
  }

  function tg_(method, payload, retries) {
    const token = token_();
    if (!token) throw new Error('LAVI_FINANCE_TELEGRAM_TOKEN belum dikonfigurasi.');
    let lastErr = null;
    const max = Math.max(0, Number(retries == null ? 1 : retries));
    for (let attempt=0; attempt<=max; attempt++) {
      try {
        const res = UrlFetchApp.fetch('https://api.telegram.org/bot' + token + '/' + method, {
          method:'post', contentType:'application/json', payload:JSON.stringify(payload || {}), muteHttpExceptions:true
        });
        const code = res.getResponseCode();
        let body = {};
        try { body = JSON.parse(res.getContentText()); } catch (_) {}
        if (code >= 200 && code < 300 && body.ok) return body.result;
        lastErr = new Error('Telegram ' + method + ' HTTP ' + code + ': ' + String(body.description || res.getContentText()).slice(0,300));
      } catch (e) { lastErr = e; }
      if (attempt < max) Utilities.sleep(500);
    }
    throw lastErr || new Error('Telegram API gagal.');
  }
  function tgDocument_(chatId, blob, caption) {
    const token=token_();if(!token)throw new Error('Token Telegram belum dikonfigurasi.');
    const res=UrlFetchApp.fetch('https://api.telegram.org/bot'+token+'/sendDocument',{
      method:'post',payload:{chat_id:String(chatId),document:blob,caption:String(caption||'').slice(0,900)},muteHttpExceptions:true
    });
    let body={};try{body=JSON.parse(res.getContentText());}catch(_){}
    if(res.getResponseCode()<200||res.getResponseCode()>=300||!body.ok)throw new Error('Telegram sendDocument gagal: '+String(body.description||res.getContentText()).slice(0,240));
    return body.result;
  }
  function answerCb_(id, text, alert) {
    try { tg_('answerCallbackQuery',{ callback_query_id:id, text:text || '', show_alert:!!alert },0); } catch (_) {}
  }
  function deleteMessage_(chatId, messageId) {
    if (!messageId) return;
    try { tg_('deleteMessage',{chat_id:String(chatId),message_id:Number(messageId)},0); } catch (_) {}
  }
  function keyboard_(rows) { return { inline_keyboard: rows || [] }; }
  function btn_(text, data) { return { text:String(text), callback_data:String(data) }; }
  function urlBtn_(text, url) { return { text:String(text), url:String(url) }; }
  function sendOrEdit_(chatId, text, rows, options) {
    options = options || {};
    const s = getSession_(chatId);
    const markup = rows ? keyboard_(rows) : undefined;
    const payload = { chat_id:String(chatId), text:String(text), parse_mode:'HTML', disable_web_page_preview:true };
    if (markup) payload.reply_markup = markup;
    let msg = null;
    if (s.last_msg_id && options.forceNew !== true) {
      try {
        const ep = Object.assign({}, payload, {message_id:Number(s.last_msg_id)});
        msg = tg_('editMessageText',ep,0);
      } catch (err) {
        // Same menu/text is already visible: treat as success, never create a duplicate message.
        if (String(err && err.message || err).toLowerCase().indexOf('message is not modified') >= 0) return {message_id:Number(s.last_msg_id), unchanged:true};
      }
    }
    if (!msg) msg = tg_('sendMessage',payload,0);
    if (msg && msg.message_id) { s.last_msg_id = msg.message_id; saveSession_(chatId,s); }
    return msg;
  }
  // Animations are intentionally disabled in webhook mode. Multiple Telegram API calls + sleep
  // delay the HTTP acknowledgement and can make Telegram redeliver the same update.
  function progress_(chatId, title, steps) { return null; }

  function esc_(v) { return String(v == null ? '' : v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function rupiah_(n) {
    const v = Math.round(Number(n) || 0);
    const sign = v < 0 ? '-' : '';
    return sign + 'Rp ' + String(Math.abs(v)).replace(/\B(?=(\d{3})+(?!\d))/g,'.');
  }
  function now_() { return new Date(); }
  function fmtDate_(d) { return Utilities.formatDate(d || new Date(),TZ,'dd/MM/yyyy'); }
  function fmtTime_(d) { return Utilities.formatDate(d || new Date(),TZ,'HH:mm'); }
  function parseDate_(s) {
    const m = String(s || '').trim().match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if (!m) return null;
    const d = new Date(Number(m[3]),Number(m[2])-1,Number(m[1]),12,0,0);
    return (d.getFullYear()===Number(m[3]) && d.getMonth()===Number(m[2])-1 && d.getDate()===Number(m[1])) ? d : null;
  }
  function menuText_() {
    const d = now_();
    return '<b>💎 LAVI FINANCE PRO</b>\n━━━━━━━━━━━━━━━━━━━━\n📅 '+HARI[d.getDay()]+', '+Number(Utilities.formatDate(d,TZ,'d'))+' '+BULAN[Number(Utilities.formatDate(d,TZ,'M'))-1]+' '+Utilities.formatDate(d,TZ,'yyyy')+'\n🕐 '+fmtTime_(d)+' WIB\n\nPilih menu pencatatan & kelola keuangan:';
  }
  function mainMenu_() { return [
    [btn_('➕ Transaksi Baru','wizard_start'),btn_('💰 Cek Saldo','btn_cek_saldo')],
    [btn_('📊 Dashboard Bulan Ini','btn_dashboard_month'),btn_('📅 Transaksi Hari Ini','btn_today_summary')],
    [btn_('📜 10 Transaksi Terakhir','btn_recent_10'),btn_('🔍 Filter & Cari','btn_filter_menu')],
    [btn_('📈 Statistik Ringkas','btn_stats'),btn_('📄 Export Excel / PDF','btn_export')],
    [btn_('🩺 Status Sistem','btn_system_status'),urlBtn_('🌐 Buka Aplikasi','https://finance.lavi.web.id')],
