    if(data==='filter_prompt_daterange'){s.step='WAIT_FILTER_DATERANGE';saveSession_(chatId,s);sendOrEdit_(chatId,'<b>📆 FILTER RENTANG TANGGAL</b>\n━━━━━━━━━━━━━━━━━━━━\nKetik rentang tanggal:\n<code>dd/mm/yyyy - dd/mm/yyyy</code>',[[btn_('◀️ Batal','btn_filter_menu')]]);return;}
    if(data.indexOf('filter_page:')===0){const st=s.filter_state||{},pg=Number(data.substring(12))||1;if(st.type==='natural')executeNaturalSearch_(chatId,st.val||'',pg);else executeFilter_(chatId,st.type||'all',st.val||'',pg);return;}
