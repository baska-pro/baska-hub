  function allTransactions_(){
    return fetchRecentTransactions().map(normalizeTx_);
  }
  function monthKey_(d){return d?Utilities.formatDate(d,TZ,'yyyy-MM'):'';}
  function aggregateTx_(list){
    const out={count:0,income:0,expense:0,net:0,categories:{}};
    (list||[]).forEach(t=>{const n=Number(t.nominal)||0;out.count++;if(t.jenis==='Pemasukan')out.income+=n;if(t.jenis==='Pengeluaran'||t.jenis==='Cicilan dan Angsuran'){out.expense+=n;out.categories[t.kategoriPilihan||'Lainnya']=(out.categories[t.kategoriPilihan||'Lainnya']||0)+n;}});out.net=out.income-out.expense;return out;
  }
  function pctText_(current,previous){
    current=Number(current)||0;previous=Number(previous)||0;if(previous===0)return current===0?'0%':'baru';const p=((current-previous)/Math.abs(previous))*100;return (p>0?'+':'')+p.toFixed(1)+'%';
  }
  function showMonthlyDashboard_(chatId){
    const cache=CacheService.getScriptCache(),now=now_(),key='lftg_monthdash_'+Utilities.formatDate(now,TZ,'yyyyMM');let data=null;
    try{const raw=cache.get(key);if(raw)data=JSON.parse(raw);}catch(_){}
    if(!data){
      const currentKey=monthKey_(now),first=new Date(now.getFullYear(),now.getMonth(),1,12),prevDate=new Date(first.getTime()-86400000),prevKey=monthKey_(prevDate),all=allTransactions_();
      const cur=[],prev=[];all.forEach(t=>{const d=parseDate_(t.tanggal),k=monthKey_(d);if(k===currentKey)cur.push(t);else if(k===prevKey)prev.push(t);});
      data={current:aggregateTx_(cur),previous:aggregateTx_(prev),currentLabel:BULAN[now.getMonth()]+' '+now.getFullYear(),previousLabel:BULAN[prevDate.getMonth()]+' '+prevDate.getFullYear()};
      try{cache.put(key,JSON.stringify(data),120);}catch(_){}
    }
    const c=data.current,p=data.previous,top=Object.keys(c.categories||{}).map(k=>({name:k,total:c.categories[k]})).sort((a,b)=>b.total-a.total).slice(0,3);
    const lines=['<b>📊 DASHBOARD BULAN INI</b>','━━━━━━━━━━━━━━━━━━━━','🗓️ <b>'+esc_(data.currentLabel)+'</b>','📋 Transaksi: <b>'+c.count+'</b>','🟢 Pemasukan: <b>'+rupiah_(c.income)+'</b>','🔴 Pengeluaran: <b>'+rupiah_(c.expense)+'</b>',(c.net>=0?'🟢':'🔴')+' Net: <b>'+rupiah_(c.net)+'</b>'];
    if(top.length){lines.push('','<b>🏆 Pengeluaran Terbesar:</b>');top.forEach((x,i)=>lines.push((i+1)+'. '+esc_(x.name)+' — <b>'+rupiah_(x.total)+'</b>'));}
    lines.push('','<b>↔️ Dibanding '+esc_(data.previousLabel)+':</b>','• Pemasukan: '+pctText_(c.income,p.income),'• Pengeluaran: '+pctText_(c.expense,p.expense),'• Net: '+pctText_(c.net,p.net),'━━━━━━━━━━━━━━━━━━━━');
    sendOrEdit_(chatId,lines.join('\n'),[[btn_('📄 Export Bulan Ini','export_scope:month'),btn_('🔄 Refresh','btn_dashboard_month')],[btn_('💰 Cek Saldo','btn_cek_saldo'),btn_('◀️ Menu Utama','btn_menu')]]);
  }
  function parseNatural_(query){
    const raw=String(query||'').trim(),q=raw.toLowerCase();const spec={raw:raw,jenis:'',person:'',date:'',wallet:'',keyword:''};
