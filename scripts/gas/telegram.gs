    const rows=[[btn_('🔴 Pengeluaran','set_type:Pengeluaran'),btn_('🟢 Pemasukan','set_type:Pemasukan')],[btn_('🔄 Pemindahan Saldo','set_type:Pemindahan Saldo'),btn_('📈 Investasi & Tabungan','set_type:Investasi dan Tabungan')]];
