  function retryInternal_(fn,retries) {
    let err; for(let i=0;i<=Math.max(0,retries||0);i++){try{return fn();}catch(e){err=e;}} throw err;
  }
  function cacheKey_(chatId){ return 'lftg_tx_v3'; }
  function clearComputedCaches_(){
    try { CacheService.getScriptCache().removeAll(['lftg_tx_v3','lftg_balance_v1','lftg_stats_v1']); } catch (_) {}
  }
  function clearTxCache_(chatId){ clearComputedCaches_(); }
  function fastRecentTransactions_(limit){
    const ss=SpreadsheetApp.openById(getSSID()), sh=ss.getSheetByName(SHEET_NAME);
    if(!sh || sh.getLastRow()<2) return [];
    const n=Math.min(Math.max(1,Number(limit)||TX_FETCH_LIMIT),sh.getLastRow()-1);
    // Responses is kept newest-first by ResponseSortService, so only read the required top rows.
    const rows=sh.getRange(2,1,n,Math.min(23,sh.getLastColumn())).getValues();
    return rows.map(function(r){
      let d=r[1], ds='';
      if(Object.prototype.toString.call(d)==='[object Date]' && !isNaN(d)) ds=Utilities.formatDate(d,TZ,'dd/MM/yyyy');
      else ds=String(d||'');
      return normalizeTx_({timestamp:r[0],tanggal:ds,jenisTransaksi:r[2],nominal:r[3],kategoriPemasukan:r[4],kategoriPengeluaran:r[5],keterangan:r[6],jenisSaldo:r[7],sumberDana:r[8],tujuanDana:r[9],jenisTabungan:r[10],kategoriPerson:r[11],rincianTransaksi:r[12],sumberLayanan:r[13],id:r[18]});
    });
  }
  function transactions_(chatId,limit){
    const cache=CacheService.getScriptCache(); let raw=null;
    try{raw=cache.get('lftg_tx_v3');}catch(_){}
    if(raw){try{return JSON.parse(raw).slice(0,limit||TX_FETCH_LIMIT);}catch(_){}}
    const list=fastRecentTransactions_(TX_FETCH_LIMIT);
    try{const json=JSON.stringify(list);if(json.length<95000)cache.put('lftg_tx_v3',json,CACHE_TTL);}catch(_){}
    return list.slice(0,limit||TX_FETCH_LIMIT);
  }
  function normalizeTx_(t) {
    t=t||{}; const jenis=t.jenis||t.jenisTransaksi||'Pengeluaran'; let cat=t.kategoriPilihan||'';
