  function isWebhook_(e,payload){return !!(payload&&payload.update_id!=null&&e&&e.parameter&&String(e.parameter.action||'')==='telegramWebhook');}

  return Object.freeze({handleUpdate:handleUpdate_,relayGet:relayGet_,relaySecretHash:relaySecretHash_,setup:setup_,status:status_,selfTest:selfTest_,resetSession:function(chatId){props_().deleteProperty(sessionKey_(chatId));return {ok:true};},isWebhook:isWebhook_});
