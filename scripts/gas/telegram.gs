    const raw=Object.assign({},t,{jenisTransaksi:j,kategoriPemasukan:j==='Pemasukan'?c:'',kategoriPengeluaran:j==='Pengeluaran'?c:'',jenisTabungan:j==='Investasi dan Tabungan'?c:'',sumberDana:t.jenisSaldo||'Cash'});
