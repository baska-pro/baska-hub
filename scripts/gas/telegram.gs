    if(data==='filter_menu_jenis'){sendOrEdit_(chatId,'<b>🏷️ PILIH FILTER JENIS</b>\n━━━━━━━━━━━━━━━━━━━━',[[btn_('🔴 Pengeluaran','filter_run:jenis_Pengeluaran'),btn_('🟢 Pemasukan','filter_run:jenis_Pemasukan')],[btn_('📈 Investasi & Tabungan','filter_run:jenis_Investasi'),btn_('🔄 Pemindahan Saldo','filter_run:jenis_Pemindahan')],[btn_('◀️ Kembali','btn_filter_menu')]]);return;}
    if(data==='filter_menu_wallet'){const rows=[];let r=[];wallets_().forEach(w=>{r.push(btn_((w==='Cash'?'💵 ':w.indexOf('Kartu')>=0?'💳 ':'🏦 ')+w,'filter_run:wallet_'+w));if(r.length===2){rows.push(r);r=[];}});if(r.length)rows.push(r);rows.push([btn_('◀️ Kembali','btn_filter_menu')]);sendOrEdit_(chatId,'<b>💳 PILIH FILTER DOMPET</b>\n━━━━━━━━━━━━━━━━━━━━',rows);return;}
    if(data==='filter_prompt_keyword'||data==='btn_search_prompt'){s.step='WAIT_SEARCH_KEYWORD';saveSession_(chatId,s);sendOrEdit_(chatId,'<b>🔤 CARI KATA KUNCI</b>\n━━━━━━━━━━━━━━━━━━━━\nKetik kata kunci transaksi:',[[btn_('◀️ Batal','btn_filter_menu')]]);return;}
    if(data==='filter_prompt_date'){s.step='WAIT_FILTER_DATE';saveSession_(chatId,s);sendOrEdit_(chatId,'<b>📅 FILTER TANGGAL CUSTOM</b>\n━━━━━━━━━━━━━━━━━━━━\nKetik tanggal: <code>dd/mm/yyyy</code>',[[btn_('◀️ Batal','btn_filter_menu')]]);return;}
